{
  "name": "@oscnord/get-video-resolution",
  "version": "2.4.0",
  "description": "Get resolution, codec, audio tracks, subtitles, bit depth, rotation, and more from any video source. Zero dependencies, no ffmpeg.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx biome check .",
    "lint:fix": "bunx biome check --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oscnord/get-video-resolution.git"
  },
  "author": "Oscar Nord",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/oscnord/get-video-resolution/issues"
  },
  "keywords": [
    "video",
    "resolution",
    "metadata",
    "codec",
    "audio-tracks",
    "hls",
    "dash",
    "mp4",
    "webm",
    "mkv",
    "avi",
    "mov",
    "hdr",
    "rotation"
  ],
  "homepage": "https://github.com/oscnord/get-video-resolution#readme",
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/bun": "^1",
    "typescript": "^7"
  }
}
